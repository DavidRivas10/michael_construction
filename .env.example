# Copia este archivo a .env.local y llena lo que ya tengas.
# Todo lo que quede vacío sigue funcionando en modo demo (se registra en la
# consola del servidor en vez de enviarse de verdad).

# --- Panel admin ---
ADMIN_PASSWORD=cambia-esta-clave
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio

# --- Correo (Resend) — https://resend.com ---
RESEND_API_KEY=

# --- WhatsApp / SMS / Llamada (Twilio) — https://twilio.com ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Estimador con IA (Claude) — https://console.anthropic.com ---
ANTHROPIC_API_KEY=
