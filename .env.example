# Copia este archivo a .env.local y llena lo que ya tengas.
# Todo lo que quede vacío sigue funcionando en modo demo (se registra en la
# consola del servidor en vez de enviarse de verdad).

# --- Panel admin (OBLIGATORIO en producción — sin esto la app no arranca) ---
ADMIN_PASSWORD=cambia-esta-clave
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio

# --- Base de datos (Supabase) — https://supabase.com ---
# SUPABASE_URL: Project Settings > General > "Project URL"
# SUPABASE_SECRET_KEY: Project Settings > API Keys > "secret key" (NUNCA la
# "publishable key" — esta variable debe quedarse solo en el servidor).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Correo (Resend) — https://resend.com ---
RESEND_API_KEY=

# --- WhatsApp / Llamada de emergencia (Twilio) — https://twilio.com ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Twilio habilitado para WhatsApp (con sandbox de prueba o ya aprobado)
TWILIO_WHATSAPP_FROM=
# Número de Twilio habilitado para llamadas de voz (puede ser el mismo número
# que el de WhatsApp si lo compraste con capacidad de Voice, o uno distinto)
TWILIO_VOICE_FROM=
# Celular real del dueño del negocio, en formato E.164 (ej: +15551234567,
# sin guiones/espacios/paréntesis) — ahí es donde suena la llamada de emergencia
TWILIO_CALL_TO=

# --- Estimador con IA (Claude) — https://console.anthropic.com ---
ANTHROPIC_API_KEY=